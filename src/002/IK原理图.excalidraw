    {"id":"fktxt","type":"text","x":100,"y":122,"width":400,"height":75,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":103,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":15,"fontFamily":1,"text":"正运动学 FK (容易, 唯一解)\n关节角 θ ──► 末端位姿 (x,y,z,α,ψ)\nT = T₁·T₂·T₃·T₄·T₅","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"正运动学 FK (容易, 唯一解)\n关节角 θ ──► 末端位姿 (x,y,z,α,ψ)\nT = T₁·T₂·T₃·T₄·T₅","lineHeight":1.25},
    {"id":"ikbox","type":"rectangle","x":640,"y":110,"width":440,"height":95,"angle":0,"strokeColor":"#e8590c","backgroundColor":"#fff4e6","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":104,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"iktxt","type":"text","x":660,"y":122,"width":400,"height":75,"angle":0,"strokeColor":"#e8590c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":105,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":15,"fontFamily":1,"text":"逆运动学 IK (难, 多解/无解) ★本项目\n末端位姿 ──► 关节角 θ\n四种方法求解, 真机验证","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"逆运动学 IK (难, 多解/无解) ★本项目\n末端位姿 ──► 关节角 θ\n四种方法求解, 真机验证","lineHeight":1.25},
    {"id":"arrow0","type":"arrow","x":525,"y":155,"width":110,"height":0,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":2},"seed":106,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"points":[[0,0],[110,0]],"lastCommittedPoint":null,"startBinding":null,"endBinding":null,"startArrowhead":"arrow","endArrowhead":"arrow"},

    {"id":"sec1box","type":"rectangle","x":40,"y":260,"width":1080,"height":230,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#ebfbee","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":200,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"sec1t","type":"text","x":60,"y":272,"width":500,"height":25,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":201,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"② 正运动学 FK 公式推导 (IK 的基础)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"② 正运动学 FK 公式推导 (IK 的基础)","lineHeight":1.25},
    {"id":"fk_step","type":"text","x":70,"y":308,"width":520,"height":170,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":202,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":14,"fontFamily":3,"text":"每个关节的齐次变换矩阵:\n  Tᵢ = Trans(origin) · Rot_fixed(rpy) · Rot(axis, θᵢ)\n\n关节绕轴 â 转 θ 的旋转 (罗德里格斯公式):\n  R(â,θ) = I + sinθ·[â]× + (1-cosθ)·[â]×²\n\n整臂末端 = 所有关节连乘:\n  T_end = T₁·T₂·T₃·T₄·T₅ · T_tool\n  位置 p = T_end[0:3, 3]\n  姿态 R = T_end[0:3, 0:3]","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"每个关节的齐次变换矩阵:\n  Tᵢ = Trans(origin) · Rot_fixed(rpy) · Rot(axis, θᵢ)\n\n关节绕轴 â 转 θ 的旋转 (罗德里格斯公式):\n  R(â,θ) = I + sinθ·[â]× + (1-cosθ)·[â]×²\n\n整臂末端 = 所有关节连乘:\n  T_end = T₁·T₂·T₃·T₄·T₅ · T_tool\n  位置 p = T_end[0:3, 3]\n  姿态 R = T_end[0:3, 0:3]","lineHeight":1.3},
    {"id":"fk_note","type":"rectangle","x":620,"y":315,"width":470,"height":160,"angle":0,"strokeColor":"#e03131","backgroundColor":"#fff5f5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":203,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"fk_note_t","type":"text","x":635,"y":325,"width":445,"height":140,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":204,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":1,"text":"⚠ 本项目踩过的两个坑 (已修复):\n\n1. 关节顺序: URDF字典序是反的且含gripper,\n   必须按 base→末端 链: pan→lift→elbow\n   →wrist_flex→wrist_roll\n\n2. 末端把手偏移: gripper_frame 有98mm,\n   FK漏算会导致把手砸桌! 已在末尾补 T_tool","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"⚠ 本项目踩过的两个坑 (已修复):\n\n1. 关节顺序: URDF字典序是反的且含gripper,\n   必须按 base→末端 链: pan→lift→elbow\n   →wrist_flex→wrist_roll\n\n2. 末端把手偏移: gripper_frame 有98mm,\n   FK漏算会导致把手砸桌! 已在末尾补 T_tool","lineHeight":1.3},

    {"id":"sec2t","type":"text","x":60,"y":515,"width":500,"height":25,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":300,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"③ 四种 IK 方法的公式推导","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"③ 四种 IK 方法的公式推导","lineHeight":1.25},

    {"id":"m1box","type":"rectangle","x":40,"y":550,"width":530,"height":210,"angle":0,"strokeColor":"#e8590c","backgroundColor":"#fff4e6","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":301,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"m1t","type":"text","x":55,"y":560,"width":500,"height":190,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":302,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":3,"text":"【方法1】解析法 (几何闭式解)\n\n余弦定理求肘关节角 θ₃:\n  cosθ₃ = (r²+z²-L₁²-L₂²) / (2·L₁·L₂)\n  θ₃ = ±arccos(...)   ← ±给出肘上/肘下(多解)\n\n肩关节: θ₂ = atan2(z,r)\n        - atan2(L₂sinθ₃, L₁+L₂cosθ₃)\n底座:   θ₁ = atan2(y, x)\n\n✓极快 ✗需精确连杆参数\n本项目结果: 参数不准 → 4/50成功, 243mm","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"【方法1】解析法 (几何闭式解)\n\n余弦定理求肘关节角 θ₃:\n  cosθ₃ = (r²+z²-L₁²-L₂²) / (2·L₁·L₂)\n  θ₃ = ±arccos(...)   ← ±给出肘上/肘下(多解)\n\n肩关节: θ₂ = atan2(z,r)\n        - atan2(L₂sinθ₃, L₁+L₂cosθ₃)\n底座:   θ₁ = atan2(y, x)\n\n✓极快 ✗需精确连杆参数\n本项目结果: 参数不准 → 4/50成功, 243mm","lineHeight":1.3},

    {"id":"m2box","type":"rectangle","x":590,"y":550,"width":530,"height":210,"angle":0,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":303,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"m2t","type":"text","x":605,"y":560,"width":500,"height":190,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":304,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":3,"text":"【方法2】数值法 (阻尼最小二乘 DLS)\n\n误差 e = x_target - x_current\n雅可比 J: ẋ = J·θ̇,  Jᵢⱼ = ∂xᵢ/∂θⱼ\n\n阻尼最小二乘迭代 (避开奇异点):\n  Δθ = Jᵀ(JJᵀ + λ²I)⁻¹ · e\n  θ ← θ + Δθ,  直到 ‖e‖<ε\n\nλ 自适应: 近奇异点(√det(JJᵀ)小)时加大\n\n✓通用最准(0.9mm) ✗慢(~15ms)依赖初值","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"【方法2】数值法 (阻尼最小二乘 DLS)\n\n误差 e = x_target - x_current\n雅可比 J: ẋ = J·θ̇,  Jᵢⱼ = ∂xᵢ/∂θⱼ\n\n阻尼最小二乘迭代 (避开奇异点):\n  Δθ = Jᵀ(JJᵀ + λ²I)⁻¹ · e\n  θ ← θ + Δθ,  直到 ‖e‖<ε\n\nλ 自适应: 近奇异点(√det(JJᵀ)小)时加大\n\n✓通用最准(0.9mm) ✗慢(~15ms)依赖初值","lineHeight":1.3},

    {"id":"m3box","type":"rectangle","x":40,"y":775,"width":530,"height":215,"angle":0,"strokeColor":"#0c8599","backgroundColor":"#e3fafc","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":305,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"m3t","type":"text","x":55,"y":785,"width":500,"height":195,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":306,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":3,"text":"【方法3】神经网络 (端到端 MLP) ★重点\n\n学习映射 f: (p,α,ψ, q_cur) → q_target\n输入12维: [x,y,z, sinα,cosα, sinψ,cosψ, q1..5]\n  (角度用sin/cos解决周期性)\n网络: 12→256→256→128→5, 输出tanh\n\n限位硬约束(tanh缩放,永不超限):\n  q = (q_hi+q_lo)/2 + (q_hi-q_lo)/2·tanh(z)\n\n✓极快(0.5ms)不需精确参数 ✗精度受数据量限","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"【方法3】神经网络 (端到端 MLP) ★重点\n\n学习映射 f: (p,α,ψ, q_cur) → q_target\n输入12维: [x,y,z, sinα,cosα, sinψ,cosψ, q1..5]\n  (角度用sin/cos解决周期性)\n网络: 12→256→256→128→5, 输出tanh\n\n限位硬约束(tanh缩放,永不超限):\n  q = (q_hi+q_lo)/2 + (q_hi-q_lo)/2·tanh(z)\n\n✓极快(0.5ms)不需精确参数 ✗精度受数据量限","lineHeight":1.3},

    {"id":"m4box","type":"rectangle","x":590,"y":775,"width":530,"height":215,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#ebfbee","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":307,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"m4t","type":"text","x":605,"y":785,"width":500,"height":195,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":308,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":3,"text":"【方法4】混合法 (NN初值 + 数值微调) ★最优\n\n  θ_final = DLS_refine( f_NN(x), N=3步 )\n\n① 神经网络给一个很接近的初值(~10mm)\n② 数值法从好初值出发, 只需2-3步微调\n③ 收敛到亚毫米\n\n为什么最优: 有了好初值, 数值法迭代极少\n→ 兼具NN的速度 + 数值法的精度\n\n结果: 软件中位0.9mm, 比纯数值法快2倍","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"【方法4】混合法 (NN初值 + 数值微调) ★最优\n\n  θ_final = DLS_refine( f_NN(x), N=3步 )\n\n① 神经网络给一个很接近的初值(~10mm)\n② 数值法从好初值出发, 只需2-3步微调\n③ 收敛到亚毫米\n\n为什么最优: 有了好初值, 数值法迭代极少\n→ 兼具NN的速度 + 数值法的精度\n\n结果: 软件中位0.9mm, 比纯数值法快2倍","lineHeight":1.3},

    {"id":"sec3t","type":"text","x":60,"y":1020,"width":600,"height":25,"angle":0,"strokeColor":"#7048e8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":400,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"④ 神经网络训练数据流水线 (方案A: 真机数据驱动)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"④ 神经网络训练数据流水线 (方案A: 真机数据驱动)","lineHeight":1.25},

    {"id":"p1","type":"rectangle","x":40,"y":1060,"width":200,"height":90,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#e7f5ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":401,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"p1t","type":"text","x":52,"y":1072,"width":178,"height":65,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":402,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":1,"text":"1.真机采集(600)\n随机安全姿态→移动\n→读实际关节角q\n→FK算末端位姿","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"1.真机采集(600)\n随机安全姿态→移动\n→读实际关节角q\n→FK算末端位姿","lineHeight":1.25},
    {"id":"p2","type":"rectangle","x":290,"y":1060,"width":230,"height":90,"angle":0,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":403,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"p2t","type":"text","x":302,"y":1070,"width":208,"height":75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":404,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":3,"text":"2.数据转换(×5增强)\nq_target = q_real\n(p,α,ψ)=FK_task(q)\nq_cur=随机无关姿态★\nx=[p,sinα,cosα,\n   sinψ,cosψ,q_cur]","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"2.数据转换(×5增强)\nq_target = q_real\n(p,α,ψ)=FK_task(q)\nq_cur=随机无关姿态★\nx=[p,sinα,cosα,\n   sinψ,cosψ,q_cur]","lineHeight":1.25},
    {"id":"p3","type":"rectangle","x":570,"y":1060,"width":210,"height":90,"angle":0,"strokeColor":"#0c8599","backgroundColor":"#e3fafc","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":405,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"p3t","type":"text","x":582,"y":1072,"width":188,"height":65,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":406,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":1,"text":"3.训练MLP\nLoss=MSE(q_pred,\n  q_target)+限位惩罚\nAdam+早停\n→ik_mlp_best.pth","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3.训练MLP\nLoss=MSE(q_pred,\n  q_target)+限位惩罚\nAdam+早停\n→ik_mlp_best.pth","lineHeight":1.25},
