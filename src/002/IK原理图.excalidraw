    {"id":"shortcut","type":"rectangle","x":290,"y":1170,"width":490,"height":75,"angle":0,"strokeColor":"#e03131","backgroundColor":"#fff5f5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":412,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"shortcut_t","type":"text","x":302,"y":1180,"width":466,"height":55,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":413,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":12,"fontFamily":1,"text":"★关键教训: q_cur若用[目标+小噪声],网络会\"抄初值\"走捷径\n→真机误差112mm! 改用[随机无关姿态]逼网络真学映射→34mm","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"★关键教训: q_cur若用[目标+小噪声],网络会\"抄初值\"走捷径\n→真机误差112mm! 改用[随机无关姿态]逼网络真学映射→34mm","lineHeight":1.25},

    {"id":"sec4t","type":"text","x":60,"y":1275,"width":600,"height":25,"angle":0,"strokeColor":"#e8590c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":500,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":20,"fontFamily":1,"text":"⑤ 真机误差分解 & 闭环补偿 (今日突破)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"⑤ 真机误差分解 & 闭环补偿 (今日突破)","lineHeight":1.25},
    {"id":"err_box","type":"rectangle","x":40,"y":1310,"width":530,"height":180,"angle":0,"strokeColor":"#e8590c","backgroundColor":"#fff4e6","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":501,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"err_t","type":"text","x":55,"y":1322,"width":500,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":502,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":1,"text":"核心发现: 真机误差 ≠ 软件误差\n\n软件层: 数值0.9 / 神经网络15 / 混合0.9 mm (差16倍)\n真机层: 三方法全是 35~36 mm (几乎一样!)\n\n为什么? 真机误差主体是机械误差(~33mm):\n  · 肩部重力下垂 ~4.6°\n  · 开环控制 + 齿轮间隙\n→ IK再准也被机械误差淹没\n→ 论文关键结论: \"仿真精度 ≠ 真机精度\"","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"核心发现: 真机误差 ≠ 软件误差\n\n软件层: 数值0.9 / 神经网络15 / 混合0.9 mm (差16倍)\n真机层: 三方法全是 35~36 mm (几乎一样!)\n\n为什么? 真机误差主体是机械误差(~33mm):\n  · 肩部重力下垂 ~4.6°\n  · 开环控制 + 齿轮间隙\n→ IK再准也被机械误差淹没\n→ 论文关键结论: \"仿真精度 ≠ 真机精度\"","lineHeight":1.3},
    {"id":"cl_box","type":"rectangle","x":590,"y":1310,"width":530,"height":180,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#ebfbee","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":503,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"cl_t","type":"text","x":605,"y":1322,"width":500,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":504,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":1,"text":"如何降误差? 关节空间闭环 (不需相机!)\n\n✗ FK闭环失败: 实际位置也是FK算的, 观测不到偏差\n✓ 关节闭环成功: 编码器给真实关节角反馈\n  迭代: servo_cmd += 0.8·(q_target - q_actual)\n  命令→读实际→补差→再命令, 3~5次收敛\n\n结果: 33.6mm → 4.0mm (改善88%)\n  点5轨迹: 51→5.8→3.8→1.7mm","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"如何降误差? 关节空间闭环 (不需相机!)\n\n✗ FK闭环失败: 实际位置也是FK算的, 观测不到偏差\n✓ 关节闭环成功: 编码器给真实关节角反馈\n  迭代: servo_cmd += 0.8·(q_target - q_actual)\n  命令→读实际→补差→再命令, 3~5次收敛\n\n结果: 33.6mm → 4.0mm (改善88%)\n  点5轨迹: 51→5.8→3.8→1.7mm","lineHeight":1.3}
  ],
