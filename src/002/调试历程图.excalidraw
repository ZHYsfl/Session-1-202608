   "text": "坑5·神经网络真机误差高达112mm ★最重要的算法突破",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "坑5·神经网络真机误差高达112mm ★最重要的算法突破",
   "lineHeight": 1.3
  },
  {
   "id": "t2031",
   "type": "text",
   "x": 164,
   "y": 816,
   "width": 547,
   "height": 99,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
