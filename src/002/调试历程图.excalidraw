    {"id":"n7box","type":"rectangle","x":150,"y":790,"width":900,"height":130,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#d3f9d8","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":9127,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"n7t","type":"text","x":165,"y":800,"width":870,"height":115,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":9128,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":14,"fontFamily":1,"text":"【突破7】把机械误差也降下来 —— 关节空间闭环 🏆 终极突破\n🔴 先试FK闭环 → 失败(只降<2mm): 因为\"实际位置\"也是FK算的, 观测不到真实物理偏差\n💡 想通: 编码器能读真实关节角! 改用关节空间闭环\n🟢 迭代: servo_cmd += 0.8·(q_target - q_actual)  命令→读实际→补差→再命令, 3~5次收敛\n✅ 效果: 真机 33.6mm → 4.0mm (改善88%!)  点5轨迹: 51→5.8→3.8→1.7mm\n     且不需要相机等外部测量设备","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"【突破7】把机械误差也降下来 —— 关节空间闭环 🏆 终极突破\n🔴 先试FK闭环 → 失败(只降<2mm): 因为\"实际位置\"也是FK算的, 观测不到真实物理偏差\n💡 想通: 编码器能读真实关节角! 改用关节空间闭环\n🟢 迭代: servo_cmd += 0.8·(q_target - q_actual)  命令→读实际→补差→再命令, 3~5次收敛\n✅ 效果: 真机 33.6mm → 4.0mm (改善88%!)  点5轨迹: 51→5.8→3.8→1.7mm\n     且不需要相机等外部测量设备","lineHeight":1.3},

    {"id":"prog_box","type":"rectangle","x":150,"y":950,"width":440,"height":180,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#ebfbee","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":9200,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"prog_t","type":"text","x":165,"y":962,"width":410,"height":160,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":9201,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":14,"fontFamily":1,"text":"📉 真机误差一路下降\n\n  神经网络首训:  112 mm   (抄初值捷径)\n         ↓ 修数据构造\n  random训练:     34 mm   (真学映射)\n         ↓ 关节空间闭环\n  闭环补偿后:      4 mm   (编码器反馈)\n\n  总共降低 96% ✅","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"📉 真机误差一路下降\n\n  神经网络首训:  112 mm   (抄初值捷径)\n         ↓ 修数据构造\n  random训练:     34 mm   (真学映射)\n         ↓ 关节空间闭环\n  闭环补偿后:      4 mm   (编码器反馈)\n\n  总共降低 96% ✅","lineHeight":1.35},

    {"id":"lesson_box","type":"rectangle","x":610,"y":950,"width":440,"height":180,"angle":0,"strokeColor":"#7048e8","backgroundColor":"#f3f0ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":9202,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"lesson_t","type":"text","x":625,"y":962,"width":410,"height":160,"angle":0,"strokeColor":"#7048e8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":9203,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":1,"text":"🎓 三条方法论(贯穿全程)\n\n1. 物理荒谬值是最好的报警器\n   (Z=-53mm 一眼看出FK错了)\n\n2. 软件指标漂亮 ≠ 真机可用\n   (损失0.003却真机112mm; 务必真机验证)\n\n3. 别靠模型猜, 要标定/测量真实量\n   (桌面高度、机械误差都要实测)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"🎓 三条方法论(贯穿全程)\n\n1. 物理荒谬值是最好的报警器\n   (Z=-53mm 一眼看出FK错了)\n\n2. 软件指标漂亮 ≠ 真机可用\n   (损失0.003却真机112mm; 务必真机验证)\n\n3. 别靠模型猜, 要标定/测量真实量\n   (桌面高度、机械误差都要实测)","lineHeight":1.35}
