    {"id":"n6num","type":"text","x":83,"y":699,"width":14,"height":20,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":9122,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"6","textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"6","lineHeight":1.25},
    {"id":"n6box","type":"rectangle","x":150,"y":670,"width":900,"height":110,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#e7f5ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":9123,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"n6t","type":"text","x":165,"y":680,"width":870,"height":95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":9124,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":14,"fontFamily":1,"text":"【发现6】真机34mm的误差到底来自哪? (对照实验)\n🔍 诊断: 同批目标点测三方法 —— 软件层 数值0.9/神经15/混合0.9mm(差16倍), 真机层全是35~36mm!\n     再测: 直接命令关节角、完全不经IK, 真机仍偏33.5mm(肩部下垂4.6°)\n💡 结论: 真机误差主体是机械误差(~33mm), 与IK方法无关 → \"仿真精度≠真机精度\"","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"【发现6】真机34mm的误差到底来自哪? (对照实验)\n🔍 诊断: 同批目标点测三方法 —— 软件层 数值0.9/神经15/混合0.9mm(差16倍), 真机层全是35~36mm!\n     再测: 直接命令关节角、完全不经IK, 真机仍偏33.5mm(肩部下垂4.6°)\n💡 结论: 真机误差主体是机械误差(~33mm), 与IK方法无关 → \"仿真精度≠真机精度\"","lineHeight":1.3},

    {"id":"n7dot","type":"ellipse","x":73,"y":815,"width":34,"height":34,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#69db7c","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":9125,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
