    {"id":"n1box","type":"rectangle","x":150,"y":70,"width":900,"height":110,"angle":0,"strokeColor":"#e03131","backgroundColor":"#fff5f5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":9103,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"n1t","type":"text","x":165,"y":80,"width":870,"height":95,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":9104,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":14,"fontFamily":1,"text":"【坑1】FK关节顺序错误\n🔴 症状: FK算出末端 Z=-53mm (末端在基座下方, 物理上荒谬)\n🔍 诊断: URDF字典序是反的、还含gripper、漏了shoulder_pan → 读URDF父子链, 确认正确链序\n🟢 解决: 按 base→末端 重建链序 [pan,lift,elbow,wrist_flex,wrist_roll]\n✅ 效果: Z 从 -53mm → +268mm (合理)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"【坑1】FK关节顺序错误\n🔴 症状: FK算出末端 Z=-53mm (末端在基座下方, 物理上荒谬)\n🔍 诊断: URDF字典序是反的、还含gripper、漏了shoulder_pan → 读URDF父子链, 确认正确链序\n🟢 解决: 按 base→末端 重建链序 [pan,lift,elbow,wrist_flex,wrist_roll]\n✅ 效果: Z 从 -53mm → +268mm (合理)","lineHeight":1.3},

