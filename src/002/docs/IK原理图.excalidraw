   "fontFamily": 1,
   "text": "方法4·混合法 (NN初值+数值微调) ★最优",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "方法4·混合法 (NN初值+数值微调) ★最优",
   "lineHeight": 1.3
  },
  {
   "id": "e1041",
   "type": "text",
   "x": 614,
   "y": 860,
   "width": 303,
   "height": 160,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
