  {
   "id": "e1063",
   "type": "text",
   "x": 54,
   "y": 1465,
   "width": 241,
   "height": 27,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
