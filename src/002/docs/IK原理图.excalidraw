  },
  {
   "id": "e1060",
   "type": "text",
   "x": 339,
   "y": 1306,
   "width": 535,
   "height": 41,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 78532,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 3,
   "text": "若 q_cur=[目标+小噪声] → 网络学会\"抄初值\"捷径, 没真学映射 → 真机误差112mm!\n改用 q_cur=[随机无关姿态] → 逼网络从位姿真学映射 → 真机34mm",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "若 q_cur=[目标+小噪声] → 网络学会\"抄初值\"捷径, 没真学映射 → 真机误差112mm!\n改用 q_cur=[随机无关姿态] → 逼网络从位姿真学映射 → 真机34mm",
   "lineHeight": 1.3
  },
