   "fontSize": 12,
   "fontFamily": 3,
   "text": "目标 (x,y)=(0.3, 0.3) m\n\nθ₁=atan2(0.3,0.3)=45°\n\n★atan2 分象限:\n (0.3,-0.3)→ -45°\n (-0.3,-0.3)→ -135°\n 普通arctan都=45°会错!",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "目标 (x,y)=(0.3, 0.3) m\n\nθ₁=atan2(0.3,0.3)=45°\n\n★atan2 分象限:\n (0.3,-0.3)→ -45°\n (-0.3,-0.3)→ -135°\n 普通arctan都=45°会错!",
   "lineHeight": 1.3
  },
