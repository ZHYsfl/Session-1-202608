   "id": "m3051",
   "type": "text",
   "x": 600,
   "y": 492,
   "width": 345,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 72003,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 1,
   "text": "余弦定理(勾股定理的推广, C=90°时退化为c²=a²+b²):",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "余弦定理(勾股定理的推广, C=90°时退化为c²=a²+b²):",
   "lineHeight": 1.3
  },
  {
   "id": "m3052",
   "type": "text",
   "x": 615,
   "y": 518,
   "width": 225,
   "height": 26,
   "angle": 0,
   "strokeColor": "#c2255c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47931,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 3,
   "text": "c² = a² + b² − 2ab·cos(C)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "c² = a² + b² − 2ab·cos(C)",
   "lineHeight": 1.3
  },
  {
   "id": "m3053",
   "type": "text",
   "x": 600,
   "y": 552,
   "width": 254,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 72300,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 1,
   "text": "套到三角形(D对着肘角, L₁L₂是夹边):",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "套到三角形(D对着肘角, L₁L₂是夹边):",
   "lineHeight": 1.3
  },
  {
   "id": "m3054",
   "type": "text",
   "x": 615,
   "y": 578,
   "width": 295,
   "height": 26,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 50791,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 3,
   "text": "D² = L₁² + L₂² − 2L₁L₂·cos(∠E)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "D² = L₁² + L₂² − 2L₁L₂·cos(∠E)",
   "lineHeight": 1.3
  },
  {
   "id": "m3055",
   "type": "text",
   "x": 600,
   "y": 610,
   "width": 215,
   "height": 24,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 70694,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 1,
   "text": "★关键: 关节角θ₃ ≠ 内角∠E !",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "★关键: 关节角θ₃ ≠ 内角∠E !",
   "lineHeight": 1.3
  },
  {
   "id": "m3056",
   "type": "text",
   "x": 600,
   "y": 634,
   "width": 293,
   "height": 23,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 97984,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 12,
   "fontFamily": 1,
   "text": "伸直时 θ₃=0 但内角=180°, 故 ∠E = π − θ₃",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "伸直时 θ₃=0 但内角=180°, 故 ∠E = π − θ₃",
   "lineHeight": 1.3
  },
  {
   "id": "m3057",
   "type": "text",
   "x": 600,
   "y": 656,
   "width": 249,
   "height": 23,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 10901,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 12,
   "fontFamily": 1,
   "text": "又 cos(π−θ₃) = −cos(θ₃), 代入得:",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "又 cos(π−θ₃) = −cos(θ₃), 代入得:",
   "lineHeight": 1.3
  },
  {
   "id": "m3058",
   "type": "text",
   "x": 600,
   "y": 686,
   "width": 313,
   "height": 27,
   "angle": 0,
   "strokeColor": "#c2255c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 80375,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 15,
   "fontFamily": 3,
   "text": "cos θ₃ = (D²−L₁²−L₂²)/(2L₁L₂)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "cos θ₃ = (D²−L₁²−L₂²)/(2L₁L₂)",
   "lineHeight": 1.3
  },
  {
   "id": "m3059",
   "type": "text",
   "x": 600,
   "y": 716,
   "width": 306,
   "height": 24,
   "angle": 0,
   "strokeColor": "#c2255c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 52344,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 3,
   "text": "       = (r'²+z'²−L₁²−L₂²)/(2L₁L₂)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "       = (r'²+z'²−L₁²−L₂²)/(2L₁L₂)",
   "lineHeight": 1.3
  },
  {
   "id": "m3060",
   "type": "rectangle",
   "x": 600,
   "y": 746,
   "width": 500,
   "height": 110,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 11818,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "m3061",
   "type": "text",
   "x": 612,
   "y": 752,
   "width": 267,
   "height": 24,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 42875,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 1,
   "text": "数字算例  (L₁=L₂=0.15m, D=0.25m):",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "数字算例  (L₁=L₂=0.15m, D=0.25m):",
   "lineHeight": 1.3
  },
  {
   "id": "m3062",
   "type": "text",
   "x": 612,
   "y": 778,
   "width": 343,
   "height": 54,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 67678,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 12,
   "fontFamily": 3,
   "text": "cosθ₃=(0.25²−0.15²−0.15²)/(2·0.15·0.15)\n      =(0.0625−0.045)/0.045 =0.389\nθ₃ = arccos(0.389) = ±67.1°   ← 为何是±? 见下方",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "cosθ₃=(0.25²−0.15²−0.15²)/(2·0.15·0.15)\n      =(0.0625−0.045)/0.045 =0.389\nθ₃ = arccos(0.389) = ±67.1°   ← 为何是±? 见下方",
   "lineHeight": 1.3
  },
  {
   "id": "m3063",
   "type": "text",
   "x": 60,
   "y": 770,
   "width": 139,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 82233,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 1,
   "text": "肩角 θ₂ = β − ψ:",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "肩角 θ₂ = β − ψ:",
   "lineHeight": 1.3
  },
  {
   "id": "m3064",
   "type": "text",
   "x": 70,
   "y": 794,
   "width": 185,
   "height": 22,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 76533,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 11,
   "fontFamily": 1,
   "text": "β=atan2(z',r') 直指腕心的仰角",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "β=atan2(z',r') 直指腕心的仰角",
   "lineHeight": 1.3
  },
  {
   "id": "m3065",
   "type": "text",
   "x": 70,
   "y": 814,
   "width": 267,
   "height": 22,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 38265,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 11,
   "fontFamily": 1,
   "text": "ψ=atan2(L₂sinθ₃, L₁+L₂cosθ₃) 肘弯补偿",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ψ=atan2(L₂sinθ₃, L₁+L₂cosθ₃) 肘弯补偿",
   "lineHeight": 1.3
  },
  {
   "id": "m3066",
   "type": "text",
   "x": 70,
   "y": 834,
   "width": 367,
   "height": 23,
   "angle": 0,
   "strokeColor": "#c2255c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 86796,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 12,
   "fontFamily": 3,
   "text": "θ₂ = atan2(z',r') − atan2(L₂sinθ₃,L₁+L₂cosθ₃)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "θ₂ = atan2(z',r') − atan2(L₂sinθ₃,L₁+L₂cosθ₃)",
   "lineHeight": 1.3
  },
