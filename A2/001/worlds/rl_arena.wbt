# ---------- 目标点标记（纯视觉：Transform 而非 Solid，雷达与碰撞都不可见） ----------
# 教训：Solid 即使不写 boundingObject，其 Shape 几何仍会被 Lidar 射线命中，
#   在目标点形成"隐形柱子"，车到 0.18 m 内先判碰撞、永远够不到 0.15 m 成功圈。
DEF GOAL Transform {
  translation 1.2 1.2 0.005
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0 0.85 0.15
        emissiveColor 0 0.5 0.1
        roughness 0.5
      }
      geometry Cylinder {
        height 0.01
        radius 0.15
      }
    }
    Transform {
      translation 0 0 0.625
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 1 0.2
            emissiveColor 0 0.9 0.25
            transparency 0.55
            roughness 0.3
          }
          geometry Cylinder {
            height 0.6
            radius 0.04
          }
        }
      ]
    }
  ]
}

# ---------- 运动学底盘机器人（无轮） ----------
# 轮式动力学已移除：机器人按 (v, w) 做理想运动学积分（env_server.step_action
# 每 10 ms 推进 yaw += w·dt、pos += v·dt·(cos yaw, sin yaw)），运动精确、
# 无打滑/钩挂/卡死。碰撞判定与 api.md §5.3 一致：雷达滤波后 min < 0.18。
# 车身：圆柱 r=0.16 h=0.12（底离地 0.02），顶置小圆台，雷达高度 0.20 m。
DEF ROBOT Robot {
  translation 0 0 0
  rotation 0 0 1 0
  children [
    DEF BODY Solid {
      translation 0 0 0.08
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.4 0.9
            metalness 0.4
            roughness 0.5
          }
          geometry Cylinder {
            height 0.12
            radius 0.16
          }
        }
        Shape {
          appearance PBRAppearance {
            baseColor 0.85 0.85 0.9
            metalness 0.6
            roughness 0.3
          }
          geometry Cylinder {
            height 0.05
            radius 0.05
          }
        }
      ]
      name "body"
      # 纯视觉节点：机器人整体为运动学模式（无 physics），不参与物理碰撞
    }
    DEF LIDAR Lidar {
      translation 0 0 0.2
      name "lidar"
      type "fixed"
      fieldOfView 6.283185
      horizontalResolution 64
      numberOfLayers 1
      near 0.03
      minRange 0.05
      maxRange 3.5
    }
  ]
  name "diffbot"
  controller "env_server"
  supervisor TRUE
  locked TRUE
  # 碰撞包络（文档用；运动学模式下无物理响应）：0.26 x 0.23 x 0.13，
  # z∈[0.02,0.15]，外接圆 hypot(0.13,0.115)=0.174 < robot_radius 0.18（§5.3）。
  boundingObject Transform {
    translation 0 0 0.085
    children [
      Box {
        size 0.26 0.23 0.13
      }
    ]
  }
}
