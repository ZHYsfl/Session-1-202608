#VRML_SIM R2025a utf8

# A2 项目（VOA 强化学习防碰撞）001 硬件侧仿真环境
# 参数与 src/001/A2/api.md §0 常量表对齐：
#   场地 4x4 m，雷达 360° x 64 线 / 量程 3.5 m，basicTimeStep 10 ms
# 底盘几何（真机对齐时改这里与 env_server.py 中的同名常量）：
#   轮半径 R=0.05 m，轮距 L=0.20 m，车身外接圆 ~0.170 m < robot_radius 0.18 m

WorldInfo {
  basicTimeStep 10
}
Viewpoint {
  orientation -0.263 0.263 0.9282 1.6452
  position 0 -5.2 3.2
}
Background {
  skyColor [
    0.2 0.24 0.3
  ]
}
DirectionalLight {
  direction -0.4 -0.6 -0.8
  intensity 1.3
  castShadows TRUE
}

# ---------- 地面（静态） ----------
DEF FLOOR Solid {
  translation 0 0 -0.001
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.56 0.56 0.6
        roughness 0.9
      }
      geometry Plane {
        size 5 5
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 4.2 4.2
  }
  locked TRUE
}

